import { db } from "@workspace/db";
import { examesTable } from "@workspace/db/schema";
import * as XLSX from "xlsx";
import { eq } from "drizzle-orm";

async function importPrices() {
  console.log("📖 A ler ficheiro Excel...");

  const workbook = XLSX.readFile("../LISTA DE PREÇOS ULTRACARDIO CLINIC.xlsx");
  const sheetName = workbook.SheetNames[0];
  const worksheet = workbook.Sheets[sheetName];

  // Lê como array de arrays para manter controlo total das linhas
  const data = XLSX.utils.sheettojson(worksheet, { header: 1 }) as any[][];
  console.log(📊 Total de linhas lidas: ${data.length});

  let inserted = 0;
  let updated = 0;
  let skipped = 0;
  let currentCategory = "geral";

  // Pula as primeiras 6 linhas (cabeçalhos vazios/título)
  for (let i = 6; i  "${priceStr}");
      skipped++;
      continue;
    }

    try {
      // Verifica existência pelo CÓDIGO (se tiver) ou pelo NOME
      const existing = await db.select().from(examesTable).where(
        code ? eq(examesTable.codigo, code) : eq(examesTable.nome, name)
      );

      if (existing.length > 0) {
        await db.update(examesTable)
          .set({ nome: name, preco: price, categoria: currentCategory })
          .where(eq(examesTable.id, existing[0].id));
        updated++;
      } else {
        await db.insert(examesTable).values({
          codigo: code || GEN-${Date.now()}, // Gera código temporário se faltar
          nome: name,
          preco: price,
          categoria: currentCategory,
          ativo: true,
        });
        inserted++;
      }

      process.stdout.write(\r✅ Processados: ${inserted + updated + skipped}/${data.length - 6});
    } catch (err) {
      console.error(\n❌ Erro em "${name}":, err);
      skipped++;
    }
  }

  console.log("\n\n🎉 IMPORTAÇÃO CONCLUÍDA!");
  console.log(   📥 Novos registos: ${inserted});
  console.log(   🔄 Atualizados:    ${updated});
  console.log(   ⏭️ Ignorados:      ${skipped});
}

function detectCategory(categoryName: string): string {
  const upper = categoryName.toUpperCase();
  if (upper.includes("BIOQUÍMICA")) return "bioquimica";
  if (upper.includes("HEMATOLOGIA")) return "hematologia";
  if (upper.includes("PARASITOLOGIA")) return "parasitologia";
  if (upper.includes("URIANALISE")) return "urinalise";
  if (upper.includes("IMUNOLOGIA")) return "imunologia";
  if (upper.includes("SEREOLOGIA") || upper.includes("TESTES RAPIDOS")) return "serologia";
  if (upper.includes("EXAMES POR PARCERIAS")) return "parcerias";
  return "geral";
}

importPrices().catch((err) => {
  console.error("💥 ERRO FATAL:", err);
  process.exit(1);
});
