# Configurar como Secrets no Replit ou num .env que não seja versionado.
DATABASE_URL=
# Usar conexão directa apenas no processo de migração.
DATABASE_URL_UNPOOLED=
SESSION_SECRET=
# A conta técnica só existe se estes dois valores forem definidos.
DEV_USERNAME=
DEV_PASSWORD=
PORT=3000
# Em desenvolvimento, pnpm dev abre apenas http://localhost:3000.
# API_PORT/WEB_PORT já não são usados pelo arranque unificado.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Opcional, apenas quando API e frontend estão em origens diferentes:
VITE_API_URL=

# Chamadas: apenas no backend; URLs separadas por virgula.
# Sem relay pre-configurado nesta entrega. Nao usar VITE_ para segredos.
CHAT_STUN_URLS=
CHAT_TURN_URLS=
CHAT_TURN_SECRET=

# Activar IA apenas após aprovação institucional; nunca usar VITE_ para segredos.
AI_ASSISTANT_ENABLED=false
AI_DOCUMENTS_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
# Alternativa opcional ao fornecedor directo: Gateway de IA da branch Neon
# (plano e região compatíveis). Os dois segredos ficam exclusivamente na API.
NEON_AI_GATEWAY_BASE_URL=
NEON_AI_GATEWAY_TOKEN=
NEON_AI_MODEL=gpt-5-mini
# A captação de voz é autorizada individualmente no navegador; não é permanente.
# Cópias fora do projecto; chave guardada em separado.
BACKUP_PASSPHRASE=
RESTORE_TEST_DATABASE_URL=
RESTORE_CONFIRM=

# No servidor Node: origem pública exacta do Portal do Paciente (HTTPS em produção).
PORTAL_ORIGIN=
# Só no ambiente de build da Netlify: URL HTTPS do backend, sem /api.
# NV_NETLIFY_API_ORIGIN=https://api.exemplo.ao
# Opcional: 1 faz as chamadas da equipa directamente à API e mantém o portal via proxy.
# NV_NETLIFY_STAFF_DIRECT=0
